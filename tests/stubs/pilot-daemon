#!/usr/bin/env bash
# Stub pilot-daemon for the tests. Never touches the network. Behaviour:
#   STUB_HELP_PROXY=1          -h lists -proxy (a daemon with native proxy support)
#   STUB_TRANSPORT_AUTO=1      -h offers -transport auto
#   STUB_X509_UNLESS_PINNED=1  logs a registry x509 error and exits 1 unless
#                              started with -registry-trust pinned
#   STUB_NEVER_REGISTER=1      runs without ever registering
#   STUB_ECHO=TEXT             logs TEXT at start (redaction tests)
# A running stub is `sleep` exec'd with argv0 = this path, so its command line
# looks like pilot-daemon's; ~/.pilot/stub-state holds "<pid> <version>" while
# registered, which the stub pilotctl reports as `info`.
STUB_VERSION="v1.0.0"
case "${1:-}" in
  -version)
    echo "pilot-daemon $STUB_VERSION"
    exit 0
    ;;
  -h | -help | --help)
    {
      echo "Usage of pilot-daemon:"
      echo "  -config string"
      printf '    \tpath to config file (JSON)\n'
      if [ "${STUB_HELP_PROXY:-0}" = 1 ]; then
        echo "  -proxy string"
        printf '    \toutbound proxy: auto, off or http(s)://[user:pass@]host[:port] (default "auto")\n'
      fi
      echo "  -transport string"
      if [ "${STUB_TRANSPORT_AUTO:-0}" = 1 ]; then
        printf "    \\ttunnel transport: 'auto', 'udp' or 'compat' (default \"auto\")\\n"
      else
        printf "    \\ttunnel transport: 'udp' (default) or 'compat'; UDP auto-detect is off (default \"udp\")\\n"
      fi
      echo "  -version"
      printf '    \tprint the version and exit\n'
    } >&2
    exit 0
    ;;
esac
echo "$*" >> "$HOME/.pilot/stub-args.log"
case " $* " in
  *" -registry-trust pinned "* | *" -registry-trust=pinned "*) pinned=1 ;;
  *) pinned=0 ;;
esac
if [ -n "${STUB_ECHO:-}" ]; then echo "level=WARN msg=stub detail=$STUB_ECHO"; fi
if [ "${STUB_X509_UNLESS_PINNED:-0}" = 1 ] && [ "$pinned" = 0 ]; then
  echo 'level=WARN msg="registry dial failed, retrying" attempt=1 error="dial registry TLS: tls: failed to verify certificate: x509: certificate signed by unknown authority"'
  sleep 1
  exit 1
fi
echo 'level=INFO msg="outbound network" transport=compat'
if [ "${STUB_NEVER_REGISTER:-0}" != 1 ]; then
  echo "$$ $STUB_VERSION" > "$HOME/.pilot/stub-state"
  echo 'level=INFO msg="daemon registered" node_id=4242 addr=0:0000.0000.1092'
fi
exec -a "$0" sleep 100000
